# Database (PostgreSQL / Supabase connection URL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# SerpApi API Keys (Rotation pool across keys)
SERPAPI_KEY_1="your_serpapi_key_1_here"
SERPAPI_KEY_2="your_serpapi_key_2_here"
SERPAPI_KEY_3="your_serpapi_key_3_here"
SERPAPI_KEY_4="your_serpapi_key_4_here"
SERPAPI_KEY_5="your_serpapi_key_5_here"

# SMTP Configuration (Nodemailer alert delivery)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
ALERT_FROM="Notice Me <noreply@noticeme.local>"

# Supabase Auth
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Gemini AI (Multi-key rotation pool for intelligent briefings & diff synthesis)
GEMINI_API_KEYS="your-gemini-api-key-1,your-gemini-api-key-2"
