# Database (PostgreSQL / Supabase connection URL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# SerpApi API Keys (Rotation pool across keys)
SERPAPI_KEY_1="your_serpapi_key_1_here"
SERPAPI_KEY_2="your_serpapi_key_2_here"
SERPAPI_KEY_3="your_serpapi_key_3_here"
SERPAPI_KEY_4="your_serpapi_key_4_here"
SERPAPI_KEY_5="your_serpapi_key_5_here"

# SMTP Configuration (Nodemailer alert delivery)
# For Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=465 (SSL recommended on Render/cloud) or 587 (TLS)
# Note: For Gmail, SMTP_PASS must be a 16-character App Password (not your Google account password): https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_character_app_password"
ALERT_FROM="Notice Me <your_email@gmail.com>"
# Optional: SMTP_SECURE=true, SMTP_FAMILY=4 (defaults to IPv4 to prevent cloud timeouts)

# Supabase Auth
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Gemini AI (Multi-key rotation pool for intelligent briefings & diff synthesis)
GEMINI_API_KEYS="your-gemini-api-key-1,your-gemini-api-key-2"
