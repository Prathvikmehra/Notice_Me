datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  plan      String   @default("free")
  createdAt DateTime @default(now())
  topics    Topic[]
}

model Topic {
  id             String     @id @default(uuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id])
  name           String
  query          String
  category       String?
  alertEmail     String?
  alertEnabled   Boolean    @default(false)
  alertFrequency String     @default("3h")
  alertHour      Int?
  alertDays      String     @default("weekdays")
  timezone       String     @default("Asia/Kolkata")
  lastAlertedAt  DateTime?
  createdAt      DateTime   @default(now())
  snapshots      Snapshot[]
  diffs          Diff[]

  @@index([userId])
}

model Snapshot {
  id       String   @id @default(uuid())
  topicId  String
  topic    Topic    @relation(fields: [topicId], references: [id])
  rawData  Json
  pulledAt DateTime @default(now())

  @@index([topicId, pulledAt(sort: Desc)])
}

model Diff {
  id         String   @id @default(uuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id])
  summary    String
  sourceUrls String[]
  detectedAt DateTime @default(now())
  alerted    Boolean  @default(false)

  @@index([topicId, detectedAt(sort: Desc)])
  @@index([topicId, alerted])
}
