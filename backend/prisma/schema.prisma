datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  plan      String   @default("free")
  createdAt DateTime @default(now())
  topics    Topic[]
}

model Topic {
  id             String     @id @default(uuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id])
  name           String
  query          String
  category       String?
  alertEmail     String?
  alertEnabled   Boolean    @default(false)
  alertFrequency String     @default("3h")
  lastAlertedAt  DateTime?
  createdAt      DateTime   @default(now())
  snapshots      Snapshot[]
  diffs          Diff[]
}

model Snapshot {
  id       String   @id @default(uuid())
  topicId  String
  topic    Topic    @relation(fields: [topicId], references: [id])
  rawData  Json
  pulledAt DateTime @default(now())
}

model Diff {
  id         String   @id @default(uuid())
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id])
  summary    String
  sourceUrls String[]
  detectedAt DateTime @default(now())
  alerted    Boolean  @default(false)
}
