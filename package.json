{
  "name": "notice-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/src/index.js",
    "backend": "npm --workspace=backend run dev",
    "frontend": "npm --workspace=frontend run dev",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "test": "node --experimental-vm-modules --test tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.15",
    "prisma": "^5.22.0"
  }
}
